<configure xmlns:ploneasgi="http://namespaces.plone.org/ploneasgi">

  <!-- Two guards on one handler: one any visitor passes, one only a Manager
       does. The live checks need both sides of the permission boundary. -->
  <ploneasgi:route
      handler="endpoints.whoami"
      name="whoami"
      path="/whoami"
      permission="zope2.View"
      site="Plone"
      />

  <ploneasgi:route
      handler="endpoints.whoami"
      name="whoami-manager"
      path="/whoami-manager"
      permission="cmf.ManagePortal"
      site="Plone"
      />

  <!-- A blob streamed from a native route: opened in the worker thread, sent
       after it is released. -->
  <ploneasgi:route
      handler="endpoints.download"
      name="download"
      path="/download/{path:path}"
      permission="zope2.View"
      site="Plone"
      />

</configure>
